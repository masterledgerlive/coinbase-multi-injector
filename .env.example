# Coinbase API Configuration
COINBASE_API_KEY=your_api_key_here
COINBASE_API_SECRET=your_api_secret_here
COINBASE_PRIVATE_KEY=your_private_key_here

# Service Configuration
PORT=3000
NODE_ENV=development

# Enabled Chains (comma-separated)
ENABLED_CHAINS=ethereum,base,polygon,solana,arbitrum,optimism

# Default Chain for Auto-Selection
DEFAULT_CHAIN=base

# Gas Configuration
MAX_GAS_PRICE=100
GAS_MULTIPLIER=1.1

# Injection Configuration
DEFAULT_INJECTION_METHOD=calldata
BATCH_SIZE=10
BATCH_TIMEOUT=30000

# Logging
LOG_LEVEL=info

# Railway Configuration (auto-filled by Railway)
RAILWAY_ENVIRONMENT=development
RAILWAY_REGION=us-west
